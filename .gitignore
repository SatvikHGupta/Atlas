# dependencies
node_modules/

# Next.js / Vercel build output
/.next/
/out/
/build/
/.vercel/
next-env.d.ts

# generated by `npm run build` (Vercel rebuilds these from raw-data/)
/content/
/public/data/
/raw-data/company-problems/
# NOTE: src/constants/tags.generated.js is generated too but must stay committed
# (`validate` compares against the committed copy).

# raw-data/notes/ is the source of truth for notes. The build copies it into
# content/notes/ (overwrites folder), so never hand-edit or commit content/notes/.
content/notes/

# env / secrets (set NEXT_PUBLIC_* vars in the Vercel dashboard instead)
.env
.env.*
!.env.example
firebase-service-account*.json
*serviceAccount*.json
*.pem

# firebase config (rules are published from the Firebase console)
/firebase.json
/firestore.rules
/firestore.indexes.json

# local-only, not needed to build or deploy
/tests/
/vitest.config.js
/data-facts/
/raw-data/_gap-solutions-source/
/scripts/migrate-progress-ids.mjs
/scripts/prune-retired-problems.mjs
/scripts/extract-company-pools.mjs
/scripts/roadmap-coverage.mjs
/scripts/one-time/

# logs, zips, tool caches
*.log
*.zip
.eslintcache
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/