# Copy this file to .env.local and fill in your Firebase project's web
# config (Firebase Console -> Project Settings -> General -> Your apps ->
# SDK setup and configuration -> Config). These are all NEXT_PUBLIC_ because
# the Firebase JS SDK is client-side by design - that's normal, not a leak;
# your actual access control lives in firestore.rules, not in hiding these.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Used for absolute URLs in metadata (og:url etc). Set to your real domain
# in production; localhost default is fine for `npm run dev`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: reCAPTCHA v3 site key for Firebase App Check (see src/services/firebase.js). Register the web app in
# Firebase Console -> App Check, then enforce it for Firestore once traffic looks healthy.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional: contact address shown on the privacy page (falls back to a generic line when empty).
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: Logo.dev publishable token for company logos (see src/lib/companyLogos.js).
NEXT_PUBLIC_LOGO_DEV_TOKEN=
